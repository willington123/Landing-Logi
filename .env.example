# Clave de Google Gemini. Si la pones aquí (en .env.local), la app no la pide en pantalla.
# Consíguela en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opcional: forzar otros modelos cuando Google publique versiones nuevas
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Imágenes gratis con Cloudflare Workers AI (10.000 neuronas/día en el plan gratuito).
# Se intenta FLUX.2 klein 4B (~79 imágenes/día) y, si no responde, klein 9B (~6 imágenes/día).
# Dashboard de Cloudflare > Workers AI > "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Imágenes de pago con Replicate (se paga a Replicate, no a Google). Modelo por defecto:
# google/nano-banana (el modelo de imágenes de Gemini), unos 0,04 USD por imagen.
# Token en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=google/nano-banana

# Proveedor de imágenes: auto (Gemini → Replicate → Cloudflare, según lo configurado),
# o fuerza uno: gemini, replicate o cloudflare.
# Si tu clave de Gemini es gratuita, pon "replicate" o "cloudflare" para no perder tiempo intentando Gemini.
IMAGE_PROVIDER=auto

# ---------- Publicación (Supabase + Vercel) ----------
# Base de datos: landings, pedidos e imágenes. Sin estas dos variables todo se guarda
# solo en el navegador (sirve para probar en tu ordenador, no para clientes reales).
# Supabase → Project Settings → API Keys: la URL del proyecto y una clave SECRETA
# ("Secret keys", empieza por sb_secret_…; o la clave legacy "service_role").
# No uses la clave "publishable": es pública y no tiene permisos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña del panel. Obligatoria al publicar: sin ella cualquiera podría entrar al
# panel y gastar tus claves de IA. Las landings públicas (/p/...) siguen abiertas.
ADMIN_PASSWORD=
# Opcional: texto aleatorio largo para firmar la sesión (si no, se usa la contraseña).
AUTH_SECRET=
